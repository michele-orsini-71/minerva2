{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Minerva": "Debug",
      "Minerva.MarkdownIndexer": "Debug",
      "Microsoft": "Warning"
    },
    "File": {
      "LogLevel": {
        "Default": "Debug"
      },
      "Path": "~/.minerva/logs/indexer-{Date}.log"
    }
  },
  "Minerva": {
    "ConnectionString": "Host=localhost;Database=minerva;Username=minerva;Password=minerva",
    "Embedding": {
      "BaseUrl": "http://localhost:1234/v1",
      "Model": "text-embedding-bge-m3",
      "Concurrency": 1,
      "BatchSize": 1
    },
    "Chunking": {
      "TargetChunkSize": 1200,
      "ChunkOverlap": 200,
      "ChunkerType": "Custom"
    }
  },
  "Indexer": {
    "AllowSourceScopeChange": true,
    "ExcludeDirectories": [],
    "FileExtensions": ["md"],
    "AllowRecreateOnConfigMismatch": false
  }
}
