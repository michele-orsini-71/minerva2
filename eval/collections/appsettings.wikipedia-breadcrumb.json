{
  "Logging": {
    "File": {
      "LogLevel": {
        "Default": "Debug"
      },
      "Path": "./logs/indexer-{Date}-breadcrumb.log"
    }
  },
  "Minerva": {
    "Chunking": {
      "Contextualization": {
        "Level": "Breadcrumb"
      }
    }
  },
  "Indexer": {
    "CollectionName": "wikipedia-breadcrumb",
    "RootPath": "./wikipedia-small-en-corpus",
    "AllowSourceScopeChange": true,
    "ExcludeDirectories": [],
    "FileExtensions": ["md"],
    "AllowRecreateOnConfigMismatch": false
  }
}
