{
  "Logging": {
    "File": {
      "LogLevel": {
        "Default": "Debug"
      },
      "Path": "./logs/indexer-{Date}-brief-gemma-4-e4b.log"
    }
  },
  "Minerva": {
    "Chunking": {
      "Contextualization": {
        "Level": "DocumentBrief",
        "Llm": {
          "BaseUrl": "http://localhost:1234/v1",
          "Model": "google/gemma-4-e4b",
          "Concurrency": 1
        }
      }
    }
  },
  "Indexer": {
    "CollectionName": "wikipedia-brief-gemma-4-e4b",
    "RootPath": "./wikipedia-small-en-corpus",
    "AllowSourceScopeChange": true,
    "ExcludeDirectories": [],
    "FileExtensions": ["md"],
    "AllowRecreateOnConfigMismatch": false
  }
}
