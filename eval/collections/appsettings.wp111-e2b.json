{
  "Logging": {
    "File": {
      "LogLevel": {
        "Default": "Debug"
      },
      "Path": "./logs/indexer-{Date}-wp111-e2b.log"
    }
  },
  "Minerva": {
    "Chunking": {
      "Llm": {
        "BaseUrl": "http://localhost:1234/v1",
        "Model": "google/gemma-4-e2b",
        "Concurrency": 1
      }
    }
  },
  "Indexer": {
    "CollectionName": "wp111-e2b",
    "RootPath": "./wikipedia-small-en-corpus",
    "AllowSourceScopeChange": true,
    "ExcludeDirectories": [],
    "FileExtensions": ["md"],
    "AllowRecreateOnConfigMismatch": false
  }
}
