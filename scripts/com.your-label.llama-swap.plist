<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.your-label.llama-swap</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/llama-swap</string>
      <string>--config</string>
      <string>/Users/your-username/.config/minerva/llama-swap.yml</string>
      <string>--listen</string>
      <string>localhost:9930</string>
    </array>
    <key>RunAtLoad</key>
    <true />
    <key>KeepAlive</key>
    <true />
    <key>StandardOutPath</key>
    <string>/Users/your-username/.local/state/minerva/logs/llama-swap.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/your-username/.local/state/minerva/logs/llama-swap.log</string>
  </dict>
</plist>
