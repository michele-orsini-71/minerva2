{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Minerva": "Debug",
      "Minerva.MarkdownIndexer": "Debug",
      "Microsoft": "Warning"
    }
  },
  "Minerva": {
    "ConnectionString": "Host=localhost;Database=minerva;Username=minerva;Password=minerva",
    "Embedding": {
      "BaseUrl": "http://localhost:1234/v1",
      "Model": "text-embedding-bge-m3"
    },
    "Chunking": {
      "MaxSegmentChars": 8000,
      "Llm": {
        "BaseUrl": "http://localhost:1234/v1",
        "Model": "google/gemma-4-e4b",
        "ContextLengthProbe": "LMStudio",
        "ContextBudget": {
          "MaxContextTokens": 4096,
          "ReservedTokens": 512,
          "CharsPerToken": 3.0,
          "SafetyFactor": 0.9
        }
      }
    }
  },
  "Indexer": {
    "RootPath": "/Users/michele/Library/Mobile Documents/iCloud~md~obsidian/Documents/my-notes",
    "CollectionName": "test-1"
  }
}
