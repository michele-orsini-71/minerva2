{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "File": {
      "LogLevel": {
        "Default": "Debug"
      },
      "Path": "~/.minerva/logs/indexer-{Date}.log"
    }
  },
  "Minerva": {
    "ConnectionString": "Host=localhost;Database=minerva;Username=minerva;Password=minerva",
    "Embedding": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "nomic-embed-text",
      "Concurrency": 1,
      "BatchSize": 1
    },
    "Chunking": {
      "TargetChunkSize": 1200,
      "ChunkOverlap": 200,
      "ContextBudget": {
        "MaxContextTokens": 4096,
        "ReservedTokens": 512,
        "CharsPerToken": 3.0,
        "SafetyFactor": 0.9
      },
      "ChunkerType": "Custom"
    }
  },
  "Indexer": {
    "RootPath": "/path/to/markdown/root",
    "CollectionName": "my-notes",
    "ExcludeDirectories": [ ".obsidian", ".trash", ".git" ]
  }
}
