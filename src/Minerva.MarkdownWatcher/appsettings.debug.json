{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Minerva": "Debug",
      "Minerva.MarkdownWatcher": "Debug",
      "Microsoft": "Warning"
    }
  },
  "Minerva": {
    "ConnectionString": "Host=localhost;Database=minerva;Username=minerva;Password=minerva",
    "Embedding": {
      "BaseUrl": "http://localhost:1234/v1",
      "Model": "text-embedding-bge-m3",
      "Concurrency": 1,
      "BatchSize": 1
    },
    "Llm" : {
      "BaseUrl": "http://localhost:1234/v1",
      "Model": "gemma-3-4b",
      "Concurrency": 1,
      "BatchSize": 1
    },
    "Chunking": {
      "TargetChunkSize": 1200,
      "ChunkOverlap": 200,
      "EnableSummarization": true,
      "EnableContextualization": true,
      "LargeDocumentThreshold": 8000
    }
  },
  "Watcher": {
    "RootPath": "/Users/michele/Library/Mobile Documents/iCloud~md~obsidian/Documents/my-notes",
    "CollectionName": "test-1",
    "FilePattern": "*.md",
    "DebounceMs": 500,
    "ExcludeDirectories": [ ".obsidian", ".trash", ".git" ]
  }
}
