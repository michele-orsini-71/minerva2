{
  "profiles": {
    "Minerva.Search.Bench running": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "run --sweep eval/sweeps/private/personal-notes-debug.toml --out eval/results"
    },
    "Minerva.Search.Bench authoring": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "author-dataset test-1-dataset.jsonl --collection test-1"
    },
    "Minerva.Search.Bench validating": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "validate-dataset test-1-dataset.jsonl --collection test-1"
    }
  }
}
