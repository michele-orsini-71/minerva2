{
  "profiles": {
    "Minerva.Search.Bench running": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "run --sweep eval/experiments/your-experiment/your-config.toml --out eval/experiments/your-experiment/runs --config src/Minerva.Search.Bench/appsettings.json"
    },
    "Minerva.Search.Bench authoring": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "author-dataset eval/datasets/your-dataset.jsonl --collection your-collection-name --config src/Minerva.Search.Bench/appsettings.json"
    },
    "Minerva.Search.Bench validating": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "validate-dataset eval/datasets/your-dataset.jsonl --collection your-collection-name --config src/Minerva.Search.Bench/appsettings.json"
    }
  }
}
