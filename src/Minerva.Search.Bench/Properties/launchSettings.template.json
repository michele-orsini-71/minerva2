{
  "profiles": {
    "Minerva.Search.Bench running": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "run --sweep eval/experiments/<experiment>/<config>.toml --out eval/experiments/<experiment>/runs"
    },
    "Minerva.Search.Bench authoring": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "author-dataset eval/datasets/<your-dataset>.jsonl --collection <collection-name>"
    },
    "Minerva.Search.Bench validating": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "debug"
      },
      "workingDirectory": "$(ProjectDir)../..",
      "commandLineArgs": "validate-dataset eval/datasets/<your-dataset>.jsonl --collection <collection-name>"
    }
  }
}
